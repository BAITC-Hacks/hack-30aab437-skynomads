{
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{db.json,models/**/*.json,public/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/media/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}
